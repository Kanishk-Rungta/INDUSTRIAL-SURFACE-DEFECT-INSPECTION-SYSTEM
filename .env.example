# Industrial Surface-Defect Inspection System - environment configuration
# Copy to .env and edit. No secrets belong in this file; the application has no
# accounts, no API keys and no outbound network calls.

APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# Mock mode is the default: every screen works with no ONNX file present.
DEMO_MODE=false
INSPECTION_PROVIDER=real

DATABASE_PATH=data/inspection.db
MODEL_PATH=data/export/model.onnx
STATION_ID=line-1-cam-A

BATCH_ROOT=data/batches
OVERLAY_ROOT=data/overlays
SOURCE_ROOT=data/sources
EXPORT_ROOT=data/exports
LOG_ROOT=data/logs
METRICS_PATH=data/metrics/coverage.json

MIN_FREE_DISK_GB=5
MAX_UPLOAD_MB=20
MAX_IMAGE_WIDTH=12000
MAX_IMAGE_HEIGHT=12000
MIN_IMAGE_WIDTH=32
MIN_IMAGE_HEIGHT=32

# Expected SHA-256 of MODEL_PATH. Leave blank in mock mode. In real mode a mismatch
# stops inspection rather than producing results from an unidentified model.
MODEL_SHA256=

# Deterministic seed for the mock provider and the database seed.
MOCK_SEED=404

# Live screen poll interval in milliseconds (Phase 2: refresh every 2-3 s).
LIVE_POLL_MS=2500

# Optional mock/demo tuning. Normal operation is fully local and real-model based.
MOCK_IMAGE_MAX_WIDTH=0

# Force batch runs onto the request thread even when not serverless.
BATCH_SYNCHRONOUS=false
